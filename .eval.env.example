# Corpus manifest for scripts/review-local.sh — copy to `.eval.env` and fill in.
#
# `.eval.env` is GIT-IGNORED, exactly like `.metrics.env`, because this repo is
# PUBLIC and the corpus is private client work. Placeholder names only in here.

# The repository the local review runs against.
EVAL_REPO=owner/repo-a

# Working root: the clone, the per-run /tmp replacement, and the results.
# EVAL_ROOT=/tmp/claude-review-eval

# The reviewing model — review-scan and review-verify.
# EVAL_MODEL=claude-opus-5
# The orchestrator session's own model. It reviews nothing, so it need not be
# the reviewing model; CI runs Sonnet here (`model_orchestrator`).
# EVAL_ORCH_MODEL=claude-sonnet-5

# The PRs a sweep walks, space-separated. Read by `make eval` / `make eval-spec`
# ONLY — `make` needs it unquoted, so leave it unquoted. review-local.sh reads
# this file as data (never `.`-sources it) and ignores this key entirely.
EVAL_PRS=101 102 103
